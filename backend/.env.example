# Copy to backend/.env and fill in values. Never commit backend/.env.
# Real environment variables override this file. In Docker/Cloud Run there is
# no .env file: set these as env vars / Secret Manager secrets instead.

# --- Secrets ---
GOOGLE_API_KEY=
SUPABASE_KEY=
GOOGLE_CLIENT_SECRET=

# --- Auth / Supabase (not secret, but required for login) ---
SUPABASE_URL=
GOOGLE_CLIENT_ID=

# --- Deployment ---
# Optional below: uncomment only to override (an empty value overrides the default!)
# Comma-separated browser origins allowed by CORS (no trailing slash).
# CORS_ORIGINS=
# Storage paths (container defaults: /tmp/chroma and /tmp/traces.jsonl)
# CHROMA_DIR=
# TRACES_PATH=

# --- Optional tuning (defaults in app/config.py) ---
# EMBEDDING_MODEL=
# CHUNK_SIZE=
# CHUNK_OVERLAP=
# LLM_MODEL=
# JSON list, e.g. ["gemini-2.5-flash"]
# LLM_FALLBACK_MODELS=
# LLM_TEMPERATURE=
# TOP_K=
# RELEVANCE_MAX_DISTANCE=
# MEMORY_MAX_TURNS=
